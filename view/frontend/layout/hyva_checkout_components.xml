<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.bold.spi"
                   as="bold"
                   template="Bold_CheckoutPaymentBooster::hyva/component/payment/method/spi.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Bold\CheckoutPaymentBooster\ViewModel\Hyva\Bold</argument>
                </arguments>
            </block>

            <block name="checkout.payment.method.bold.wallet"
                   as="bold_wallet"
                   template="Bold_CheckoutPaymentBooster::hyva/component/payment/method/wallet.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Bold\CheckoutPaymentBooster\ViewModel\Hyva\Bold</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.bold.fastlane"
                   as="bold_fastlane"
                   template="Bold_CheckoutPaymentBooster::hyva/component/payment/method/fastlane.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Bold\CheckoutPaymentBooster\ViewModel\Hyva\Bold</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
